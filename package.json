{
  "name": "@jayyuen66/dsh-zvec-grep",
  "version": "0.1.9",
  "description": "dsh 工作区语义检索插件（zg）：zg_search / zg_index / zg_status + 本地 embedding 设置卡片 + systemPrompt 路由规则 + guard 安全兜底。",
  "keywords": [
    "cordis",
    "dsh",
    "embedding",
    "plugin",
    "semantic-search",
    "workspace",
    "zvec"
  ],
  "homepage": "https://github.com/JayYuen666/dsh-zvec-grep#readme",
  "bugs": {
    "url": "https://github.com/JayYuen666/dsh-zvec-grep/issues"
  },
  "license": "MIT",
  "author": "JayYuen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayYuen666/dsh-zvec-grep.git"
  },
  "files": [
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "host.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:client": "node build-client.mjs",
    "build": "node build-host.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.build-scripts.json",
    "lint": "oxlint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:platform": "vitest run --coverage.enabled=false",
    "check": "npm run --loglevel=warn typecheck && npm run --loglevel=warn lint && npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn test && npm run --loglevel=warn fmt:check",
    "check:platform": "npm run --loglevel=warn typecheck && npm run --loglevel=warn lint && npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn test:platform && npm run --loglevel=warn fmt:check",
    "prepack": "npm run --loglevel=warn build:client && npm run --loglevel=warn build",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "prepare": "npm run --loglevel=warn build:client && npm run --loglevel=warn build"
  },
  "dependencies": {
    "@jayyuen66/dsh-plugin-shared": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-timer": "1.1.8-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-bash-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-jobs-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-output-retention": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-shell": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@e18e/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-zod": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "^19.3.0",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-output-retention": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "icon": "icon.svg",
  "engines": {
    "dsh": "^0.2.1-rc.3",
    "node": ">=22.12.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
